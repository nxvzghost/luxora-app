# Luxora — variáveis do BACKUP (staging). MODELO, sem segredo nenhum.
#
# Instalado no servidor como /etc/luxora-backup/staging.env (dono root, grupo luxora-backup, modo 0640):
#   sudo install -m 0640 -o root -g luxora-backup infra/staging/.env.backup.example /etc/luxora-backup/staging.env
# e editado no servidor (sudoedit). É lido SÓ pelo usuário luxora-backup (units luxora-backup@ e
# luxora-backup-health@), nunca pela aplicação nem pelo deploy. Procedimento completo:
# docs/07-Infra/BACKUP_ISOLADO.md.
#
# NÃO coloque aqui nenhum segredo da aplicação (senhas do banco, JWT, chaves do WhatsApp, Asaas,
# Anthropic...): o backup-job.sh recusa um arquivo que tenha qualquer um deles, e também recusa um arquivo
# legível por outros ou com escrita para o grupo. A senha da role luxora_backup também NÃO entra aqui:
# ela só existe no arquivo de senhas do PostgreSQL (BACKUP_PG_PASSFILE, abaixo).
#
# O valor "troque-este-valor" é recusado pelos scripts: o backup não roda com este modelo sem edição.

# --- identificação e banco (o mesmo ambiente e o mesmo banco da aplicação)
APP_ENV=staging
POSTGRES_DB=luxora_staging

# --- conexão do pg_dump (roda NO HOST; sem Docker). Postgres do compose publicado só em 127.0.0.1.
BACKUP_PG_HOST=127.0.0.1
# Igual a POSTGRES_BACKUP_PORT do arquivo de ambiente da aplicação (padrão 15432).
BACKUP_PG_PORT=15432
BACKUP_PG_USER=luxora_backup
# Arquivo no formato pgpass (host:porta:banco:usuário:senha), dono luxora-backup, modo 0400 ou 0600, sem
# link simbólico. A senha é a POSTGRES_BACKUP_PASSWORD do arquivo de ambiente da aplicação.
BACKUP_PG_PASSFILE=/etc/luxora-backup/backup.pgpass
# Opcional (padrão prefer). O Postgres do compose não tem TLS: NÃO use require, verify-ca nem verify-full
# sem antes configurar TLS no servidor — a conexão falharia. disable e prefer servem no loopback.
# BACKUP_PG_SSLMODE=prefer

# --- armazenamento externo compatível com S3 (endereçamento por caminho). Ver DEPLOY_RUNBOOK,
# "Configuração esperada com o Cloudflare R2". Nada disso foi testado contra um armazenamento real.
BACKUP_S3_ENDPOINT=troque-este-valor
BACKUP_S3_REGION=troque-este-valor
BACKUP_S3_BUCKET=troque-este-valor
BACKUP_S3_PREFIX=luxora
BACKUP_S3_ACCESS_KEY_ID=troque-este-valor
BACKUP_S3_SECRET_ACCESS_KEY=troque-este-valor
# Arquivo com a chave de cifragem (dono luxora-backup, modo 0400 ou 0600, 24+ caracteres). NÃO é a chave
# em si. Guarde uma cópia FORA do servidor: sem ela, os backups não abrem.
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/luxora-backup/backup-passphrase
BACKUP_VERIFY_AFTER_UPLOAD=1

# --- verificação e alertas (opcionais)
# Limite de idade do último backup, em horas (1 a 8760; padrão 26).
# BACKUP_MAX_AGE_HOURS=26
# Caminho ABSOLUTO do notificador (executável de root:root, sem escrita para grupo/outros; sugestão:
# /opt/luxora-backup/notify/notificador). Vazio = sem canal: o log diz "ALERTA NÃO ENVIADO".
# BACKUP_ALERT_NOTIFIER=
# BACKUP_ALERT_REPEAT_HOURS=12
# BACKUP_ALERT_TIMEOUT_SECONDS=30
