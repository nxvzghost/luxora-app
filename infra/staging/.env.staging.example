# Luxora — variáveis da homologação (staging). MODELO, sem segredo nenhum.
#
# Não copie e edite à mão: gere o arquivo real, com segredos aleatórios, com
#   infra/scripts/generate-env.sh <caminho-fora-do-repositório>/staging.env
# e depois preencha só os endereços e as chaves de integração.
#
# O arquivo real NUNCA entra no Git. Os valores "troque-este-valor" abaixo
# são recusados pela aplicação em produção: ela não sobe com este modelo.
#
# Senhas e segredos: só letras e números (as senhas do banco entram em uma URL).

# --- identificação
APP_ENV=staging

# --- banco (o Postgres do compose; num banco gerenciado, só as senhas valem)
POSTGRES_DB=luxora_staging
# Usuário admin: roda as migrations e os backups. Nunca é entregue à aplicação.
POSTGRES_ADMIN_PASSWORD=troque-este-valor
# Role restrita luxora_app: é com ela que a aplicação conecta.
POSTGRES_APP_PASSWORD=troque-este-valor

# --- endereços
# Origem(ns) do painel aceitas pelo CORS da API, separadas por vírgula.
FRONTEND_URL=https://painel-staging.exemplo.com.br
# Portas no loopback do host (o proxy com TLS aponta para elas).
BACKEND_PORT=13000
FRONTEND_PORT=13001

# --- proxy HTTPS (Caddy). Vazios = o proxy não sobe e a API e o painel ficam só no loopback.
# Nome de host, SEM https:// e SEM caminho. Os dois precisam ter DNS apontando para o servidor.
# PUBLIC_PANEL_HOST deve ser o mesmo host de FRONTEND_URL; o api_url do CD é https://<PUBLIC_API_HOST>/api/v1.
# Exemplos: api-staging.exemplo.com.br e painel-staging.exemplo.com.br
PUBLIC_API_HOST=
PUBLIC_PANEL_HOST=

# --- segredos da aplicação (32+ caracteres os dois primeiros)
JWT_SECRET=troque-este-valor
WHATSAPP_TOKEN_ENCRYPTION_KEY=troque-este-valor
WHATSAPP_APP_SECRET=troque-este-valor
WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque-este-valor
ASAAS_WEBHOOK_TOKEN=troque-este-valor
AUTOMATION_API_KEY=troque-este-valor
METRICS_ACCESS_TOKEN=troque-este-valor

# --- integrações externas (vazias = integração desligada)
# Homologação usa SEMPRE o sandbox da Asaas e uma chave de teste da Anthropic.
ANTHROPIC_API_KEY=
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# --- observabilidade (vazio = nenhum trace exportado)
# Com o coletor do compose (--profile observability): http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=log

# --- backup externo cifrado (infra/scripts/external-backup.sh). Tudo vazio = desligado.
# Qualquer armazenamento compativel com S3 com enderecamento por caminho: <endpoint>/<bucket>/<chave>.
# Endpoint em https://. Credencial de envio: so escrita (e BACKUP_VERIFY_AFTER_UPLOAD=0) ou escrita + leitura.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=luxora
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Caminho de um arquivo (permissao 600, 24+ caracteres) com a chave de cifragem. NAO e a chave em si.
# Guarde uma copia dessa chave FORA do servidor: sem ela, os backups externos nao abrem.
BACKUP_ENCRYPTION_PASSPHRASE_FILE=
BACKUP_VERIFY_AFTER_UPLOAD=1
