# Luxora — agenda do backup externo (uma vez por dia). Ativa luxora-backup@<ambiente>.service.
# PREPARADO, NÃO INSTALADO NEM VALIDADO EM SERVIDOR REAL.
[Unit]
Description=Luxora backup externo diário (%i)

[Timer]
# 03:30 UTC = 00:30 em Brasília, fora do horário de uso das clínicas.
OnCalendar=*-*-* 03:30:00 UTC
# Se o servidor estava desligado no horário, roda assim que ligar (execução perdida é recuperada).
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
