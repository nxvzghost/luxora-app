# Luxora — backup externo diário (A-12). Modelo por ambiente: luxora-backup@staging.service
# usa /etc/luxora/staging.env. PREPARADO, NÃO INSTALADO NEM VALIDADO EM SERVIDOR REAL.
# Instalação e alterações (usuário, caminhos): docs/07-Infra/DEPLOY_RUNBOOK.md,
# "Agendamento e alertas do backup".
[Unit]
Description=Luxora backup externo (%i)
Documentation=file:///srv/luxora-app/docs/07-Infra/DEPLOY_RUNBOOK.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Usuário sem privilégios, o mesmo dono do arquivo de ambiente e do estado (checklist, itens 2 e 7).
# Ele precisa do grupo docker (pg_dump roda por docker compose exec), que equivale a acesso de
# administrador ao servidor: não é um isolamento forte.
User=deploy
Group=deploy
UMask=0077
ExecStart=/usr/bin/bash /srv/luxora-app/infra/scripts/backup-job.sh backup --env-file /etc/luxora/%i.env
# O push é demorado; passou disso, o systemd o encerra e a unidade fica "failed".
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
