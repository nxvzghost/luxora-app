{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test:unit": {
      "dependsOn": ["build"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL"]
    },
    "test:critical": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "WHATSAPP_TOKEN_ENCRYPTION_KEY"]
    },
    "test": {
      "dependsOn": ["test:unit", "test:integration", "test:critical"]
    }
  }
}
