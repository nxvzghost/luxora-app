{
  "name": "luxora",
  "private": true,
  "version": "0.1.0",
  "description": "Luxora — Plataforma operacional para clínicas de saúde mental. Tecnologia que ilumina decisões.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:critical": "turbo run test:critical",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.3.0": "^2.3.0",
      "js-yaml@<4.3.2": "^4.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "express@<4.22.3": "~4.22.3",
      "body-parser@<1.20.6": "~1.20.6",
      "qs@<6.16.0": "^6.16.0"
    }
  }
}
