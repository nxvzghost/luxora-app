// Luxora — Schema Prisma inicial (Módulo 1 — Fundação Técnica)
// Fonte de verdade: docs/03-Database/02-Tabelas.md, 03-Relacionamentos.md, 09-Multi-Tenant.md
// Toda tabela com dado de clínica carrega tenant_id — Row-Level Security aplicada via migration SQL manual
// (ver prisma/migrations/00000000000000_init_rls/migration.sql)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Tenant — raiz do isolamento multi-tenant
// ─────────────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  clinicSettings ClinicSettings?
  aiSettings     AiSettings?
  whatsappIntegration WhatsAppIntegration?
  clinicSubscription  ClinicSubscription?
  tenantApiKey   TenantApiKey?
  users          User[]
  therapists     Therapist[]
  availabilityCalendars AvailabilityCalendar[]
  clinicHolidays ClinicHoliday[]
  recurringBlocks RecurringBlock[]
  patients       Patient[]
  sessions       Session[]
  appointments   Appointment[]
  billings       Billing[]
  billingSessions BillingSession[]
  payments       Payment[]
  auditLogs      AuditLog[]
  messageLogs    MessageLog[]
  conversations  Conversation[]
  inboxEntries   InboxEntry[]
  messages       Message[]
  contacts       Contact[]
  contactPatientAssociations ContactPatientAssociation[]

  @@map("tenant")
}

enum BillingPolicy {
  per_session
  weekly
  monthly
}

model ClinicSettings {
  id                    String        @id @default(uuid())
  tenantId              String        @unique @map("tenant_id")
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  defaultBillingPolicy  BillingPolicy @default(per_session) @map("default_billing_policy")
  cancellationHoursLimit Int?          @map("cancellation_hours_limit")
  // RF-013 (06-UX/01-Fluxo-Configuracao-Clinica.md) — nunca tinha sido
  // implementado até o Módulo 07 precisar dele para calcular disponibilidade
  // (ConsultarDisponibilidade). Minutos, não um Duration/Interval — mais
  // simples de somar a um Date em JavaScript sem lib adicional.
  defaultSessionDurationMinutes Int @default(50) @map("default_session_duration_minutes")
  // Módulo 11 — necessário para o template real de cobrança (Padrão 7,
  // 05-IA/01-Tom-de-Voz...) e nunca tinha sido modelado até este módulo
  // precisar montar a mensagem de verdade.
  pixKey                String?       @map("pix_key")
  payeeName             String?       @map("payee_name")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("clinic_settings")
}

// WhatsAppIntegration — 1:1 com Tenant.
//
// CORREÇÃO ARQUITETURAL REAL (não cosmética): até esta correção,
// WhatsAppMessageProvider (Módulo 11) lia WHATSAPP_PHONE_NUMBER_ID e
// WHATSAPP_BUSINESS_API_TOKEN de variáveis de ambiente GLOBAIS — ou seja,
// toda clínica da plataforma enviaria mensagem pelo MESMO número de
// WhatsApp. Isso quebra o princípio explícito de que "cada clínica deve
// conectar seu próprio canal de WhatsApp, preservando a identidade da
// clínica" — e é, na prática, uma falha de isolamento multi-tenant na
// camada de comunicação, o mesmo tipo de problema que o Módulo 04 (RLS)
// resolveu para o banco de dados, mas que nunca tinha sido aplicado aqui.
//
// AD-005: accessToken é cifrado em repouso (AES-256-GCM, TokenCipherService,
// apps/backend/src/shared/token-cipher.service.ts) antes de ser gravado por
// ConectarWhatsAppUseCase, e decifrado só no momento de uso, em
// WhatsAppMessageProvider. A coluna continua String — o valor armazenado é
// o formato versionado `v1:<iv>:<tag>:<ciphertext>`, nunca o token em texto
// puro. Ver CONFIGURACAO_AMBIENTE.md (WHATSAPP_TOKEN_ENCRYPTION_KEY).
model WhatsAppIntegration {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  // ADR-0053/PD-007: único em todo o banco, não só por Tenant — é o lookup
  // reverso (phoneNumberId → tenantId) que o webhook do WhatsApp precisa
  // antes mesmo de saber o tenantId; sem unicidade global, dois Tenants
  // poderiam ser salvos com o mesmo número por erro operacional, uma
  // ambiguidade de isolamento equivalente, em gravidade, a uma falha de RLS.
  phoneNumberId   String   @unique @map("phone_number_id")
  accessToken     String   @map("access_token") // cifrado em repouso (AD-005) — ver comentário acima
  connectedAt     DateTime @default(now()) @map("connected_at")
  active          Boolean  @default(true)

  @@map("whatsapp_integration")
}

// ─────────────────────────────────────────────
// ADR-0053 — Domínio Comunicação/Atendimento (PD-008, versão mínima:
// sem máquina de estados, sem escalonamento — Conversation é um agregado
// de identidade/agrupamento, uma linha por par (tenantId, phoneNumber).
// ─────────────────────────────────────────────
model Conversation {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  phoneNumber String    @map("phone_number")
  patientId   String?   @map("patient_id")
  patient     Patient?  @relation(fields: [patientId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  messages Message[]

  @@unique([tenantId, phoneNumber])
  @@map("conversation")
}

enum MessageDirection {
  entrada
  saida
}

model Message {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  conversationId String            @map("conversation_id")
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  content        String
  // WAMID — só preenchido em mensagens de entrada; é a chave de idempotência
  // do webhook (ADR-0053 §5), checada antes de qualquer enfileiramento.
  externalId     String?           @unique @map("external_id")
  status         String            @default("enviada") // enviada | entregue | lida — atualizado por statuses[] da Meta
  createdAt      DateTime          @default(now()) @map("created_at")

  @@map("message")
}

// ─────────────────────────────────────────────
// ADR-0054 (AD-036) — Inbox Pattern: garantia de execução única do
// processamento assíncrono sob retry do BullMQ. Deliberadamente FORA do
// domínio Conversation/Message — é uma preocupação de confiabilidade de
// consumo de fila, não um fato de negócio sobre a conversa. `channel` é
// genérico (hoje só 'whatsapp') para permitir reuso por canais futuros
// sem tabela nova. `conversationId`/`correlationId` são valores simples,
// sem relação — decisão deliberada para não acoplar esta tabela de
// infraestrutura ao agregado Conversation.
// ─────────────────────────────────────────────
enum InboxEntryStatus {
  processing
  generated
  dispatched
  failed
}

model InboxEntry {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  channel        String
  externalId     String           @map("external_id")
  conversationId String           @map("conversation_id")
  correlationId  String?          @map("correlation_id")
  status         InboxEntryStatus @default(processing)
  // Cache técnico e descartável do resultado — só o necessário para
  // retomar o despacho (Fase 2) sem reprocessar a IA (Fase 1). Nunca a
  // fonte de verdade do conteúdo da resposta — essa é a Message
  // persistida por ProcessarMensagemWhatsAppUseCase, inalterada por esta AD.
  resultPayload  Json?            @map("result_payload")
  attempts       Int              @default(1)
  lastError      String?          @map("last_error")
  claimedAt      DateTime         @default(now()) @map("claimed_at")
  processedAt    DateTime?        @map("processed_at")
  dispatchedAt   DateTime?        @map("dispatched_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([channel, externalId])
  @@index([tenantId, conversationId])
  @@map("inbound_processing_inbox")
}

// TenantApiKey — 1:1 com Tenant (PD-003, Módulo 17). Gerar uma nova
// invalida a anterior (upsert) — 1 chave ativa por vez, sem escopo ou
// nome, suficiente para o MVP. hashedKey é SHA-256 (rápido, determinístico),
// nunca bcrypt — a chave já é um segredo de alta entropia gerado
// aleatoriamente, não uma senha escolhida por humano, então o problema que
// bcrypt resolve (dicionário) não se aplica aqui, e um hash determinístico
// é o que permite localizar a linha certa por busca indexada direta em vez
// de escanear a tabela inteira comparando hash a hash.
model TenantApiKey {
  id         String    @id @default(uuid())
  tenantId   String    @unique @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  hashedKey  String    @unique @map("hashed_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("tenant_api_key")
}

model AiSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  monthlyBudgetCap Decimal? @map("monthly_budget_cap") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

// ─────────────────────────────────────────────
// Identidade e acesso
// ─────────────────────────────────────────────
enum UserRole {
  admin
  therapist
  super_admin
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String   @map("password_hash")
  role         UserRole
  therapistId  String?  @unique @map("therapist_id")
  therapist    Therapist? @relation(fields: [therapistId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Email GLOBALMENTE único (não por Tenant) — decisão tomada no Módulo 03,
  // ver LUXORA/03 - ENGINEERING/ADRs/ADR-0024. Login recebe apenas email+senha;
  // se fosse único por Tenant, o cliente precisaria informar o tenantId antes
  // de autenticar, o que não existe em nenhum fluxo de UX já documentado.
  @@unique([email])
  @@map("user")
}

model Therapist {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  specialty String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                 User?
  sessions             Session[]
  appointments         Appointment[]
  availabilityCalendar AvailabilityCalendar?
  recurringBlocks      RecurringBlock[]

  @@map("therapist")
}

// Bounded Context `Availability` (ADR-0040, derivado de PD-001) — 1 por
// Terapeuta, referenciado por therapistId, nunca possuído por Therapist.
// Substitui o antigo Therapist.availability (Json?).
model AvailabilityCalendar {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  therapistId String    @unique @map("therapist_id")
  therapist   Therapist @relation(fields: [therapistId], references: [id])
  // Formato: [{ dayOfWeek: 0-6, startTime: "HH:mm", endTime: "HH:mm",
  // sessionDurationMinutes: number }]. Duração por janela/terapeuta —
  // decisão de produto (ver docs/11-Product-Decisions/PD-001-Motor-de-Disponibilidade).
  windows     Json
  // AD-008 — bloqueios pontuais do terapeuta (férias, licença, bloqueio
  // manual), formato [{ from: ISO date, to: ISO date, reason?: string }].
  // Mesmo tratamento de `windows`: coluna JSON no próprio Aggregate
  // (AvailabilityCalendar), nunca uma tabela própria — AvailabilityException
  // não tem existência independente do calendário que a possui.
  exceptions  Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("availability_calendar")
}

// Bounded Context `Availability` (ADR-0040, derivado de PD-001), PD-001
// Fase 2 (B3) — entidade própria, referenciada por tenantId, nunca aninhada
// em Clinic (decisão arquitetural: feriado é regra de disponibilidade, não
// configuração administrativa da Clínica — mantém o Bounded Context coeso
// junto de AvailabilityCalendar/AvailabilityException).
model ClinicHoliday {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  fromDate  DateTime @map("from_date")
  toDate    DateTime @map("to_date")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, fromDate, toDate])
  @@map("clinic_holiday")
}

// Bounded Context `Availability` (ADR-0040, derivado de PD-001), PD-001
// Fase 2 (C1/C2) — Aggregate Root independente, decisão registrada após
// análise comparativa formal (ver relatório da C1): referencia patientId e
// therapistId, nunca é possuído por AvailabilityCalendar. Índice composto
// (tenantId, therapistId) antecipa a consulta mais provável do primeiro
// consumidor real (Motor/materialização, C3) sem implementar esse
// consumidor agora — é estrutura de schema, não uma nova query no
// Repository desta etapa (C2 expõe só save()/findById()).
model RecurringBlock {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  patientId       String   @map("patient_id")
  patient         Patient  @relation(fields: [patientId], references: [id])
  therapistId     String   @map("therapist_id")
  therapist       Therapist @relation(fields: [therapistId], references: [id])
  firstOccurrence DateTime @map("first_occurrence")
  intervalDays    Int      @map("interval_days")
  modality        String
  renewalMode     String   @map("renewal_mode")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([tenantId, therapistId])
  @@map("recurring_block")
}

// ─────────────────────────────────────────────
// Domínio clínico-administrativo
// ─────────────────────────────────────────────
// Alinhado 1:1 com PatientState em domain/patient/patient.entity.ts (Módulo 02).
// Substituiu PatientStatus (3 valores: active/inactive/discharged) no Módulo 05,
// quando ficou claro que o schema do Módulo 01 nunca tinha sido reconciliado
// com a máquina de estados real definida no Domain — ver ADR-0026.
enum PatientState {
  Novo
  Identificado
  Cadastrado
  Ativo
  Agendado
  Confirmado
  EmSessao
  PagamentoPendente
  Pago
  EmFollowUp
  Inativo
  Alta
}

model Patient {
  id                     String         @id @default(uuid())
  tenantId               String         @map("tenant_id")
  tenant                 Tenant         @relation(fields: [tenantId], references: [id])
  name                   String
  phone                  String
  state                  PatientState   @default(Novo)
  billingPolicyOverride  BillingPolicy? @map("billing_policy_override")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  deletedAt              DateTime?      @map("deleted_at")

  sessions     Session[]
  appointments Appointment[]
  billings     Billing[]
  recurringBlocks RecurringBlock[]
  conversations Conversation[]
  contactAssociations ContactPatientAssociation[]

  // ADR-0053 — suporta PatientRepository.findByPhone(), usado pelo webhook
  // do WhatsApp para resolver patientId a partir do número do remetente.
  // Não-único (achado de PD-007: nada garante hoje que phone seja único por
  // Tenant — corrigir isso é dívida pré-existente, fora do escopo desta AD).
  @@index([tenantId, phone])
  @@map("patient")
}

// ─────────────────────────────────────────────
// ADR-0055 (AD-018) — Aggregate Contact: identidade de comunicação,
// Marco 1 da Arquitetura de Domínio (ADR-0043 a ADR-0046). Mesmo Bounded
// Context de Patient — Contact nunca representa vínculo clínico, só quem
// está conversando por um canal. Associação com Patient é N-para-N com
// papel explícito (ContactPatientAssociation), nunca uma FK única —
// suporta responsável/dependente e casal com telefone compartilhado
// (ADR-0045). AD-024 (colisão nominal de nome entre os estados Novo/
// Identificado de Contact e os já existentes em PatientState, puramente
// de legibilidade — enums e tipos distintos, sem colisão real de dado ou
// de tipo) fica deliberadamente fora de escopo desta AD — ver ADR-0055
// §1 "AD-024 removida desta ADR". Nenhuma alteração em Patient nesta AD.
// ─────────────────────────────────────────────
enum ContactState {
  Novo
  Conversando
  Identificado
  Vinculado
  Promovido
  Arquivado
  Descartado
}

enum ContactPatientRole {
  proprio_paciente
  responsavel_por
}

model Contact {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  // Já normalizado pelo Value Object PhoneNumber (domain/contact) antes de
  // chegar aqui — nunca o valor bruto recebido da Meta. Conversation.phoneNumber
  // (ADR-0053) permanece como está, sem normalização retroativa — ver
  // ADR-0055 "Value Object: telefone normalizado".
  // Nulo só depois de Contact.anonimizar() (expurgo LGPD, capacidade de
  // domínio desta AD — sem scheduler, ver ADR-0055 "Domain Events
  // implementados nesta AD"). Achado corrigido antes de implementar o
  // repositório: o schema original desta AD tinha isso como NOT NULL,
  // inconsistente com o domínio, que sempre permitiu phoneNumber nulo
  // pós-anonimização.
  phoneNumber String?      @map("phone_number")
  name        String?
  state       ContactState @default(Novo)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  associations ContactPatientAssociation[]

  @@unique([tenantId, phoneNumber])
  @@map("contact")
}

// Nunca uma FK única em Contact ou em Patient — a associação é sua
// própria linha, exatamente porque um Contact pode ter mais de uma
// (casal com telefone compartilhado) e um Patient pode ser alcançado por
// mais de um Contact ao longo do tempo (troca de número) — ver ADR-0043
// "Relação Contact ↔ Patient". Nunca composição (11-Aggregates-e-Limites.md
// — "não há invariante que justifique isso") — mudar uma associação nunca
// exige transação atômica com Contact nem com Patient.
model ContactPatientAssociation {
  id        String             @id @default(uuid())
  tenantId  String             @map("tenant_id")
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  contactId String             @map("contact_id")
  contact   Contact            @relation(fields: [contactId], references: [id])
  patientId String             @map("patient_id")
  patient   Patient            @relation(fields: [patientId], references: [id])
  role      ContactPatientRole
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([contactId, patientId])
  @@index([tenantId, patientId])
  @@map("contact_patient_association")
}

// Alinhado 1:1 com AppointmentState em domain/appointment/appointment.entity.ts.
// Substituiu AppointmentStatus (5 valores, faltava "Reagendada") no Módulo 07 —
// mesmo padrão de divergência já corrigido para Patient no Módulo 05 (ADR-0026).
// Ver ADR-0028.
enum AppointmentState {
  Criada
  Reservada
  Confirmada
  ReagendamentoSolicitado
  Reagendada
  Cancelada
}

model Appointment {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  patientId   String            @map("patient_id")
  patient     Patient           @relation(fields: [patientId], references: [id])
  therapistId String            @map("therapist_id")
  therapist   Therapist         @relation(fields: [therapistId], references: [id])
  scheduledAt DateTime          @map("scheduled_at")
  modality    String            @default("presencial")
  state       AppointmentState  @default(Criada)
  recurring   Boolean           @default(false)
  // PD-001 Fase 2, C3 — referência ao RecurringBlock de origem, só para
  // ocorrências materializadas. Nullable: Appointments avulsos e os
  // criados por CriarAgendamentoRecorrenteUseCase (não alterado nesta
  // etapa) não têm este campo preenchido.
  recurringBlockId String?         @map("recurring_block_id")
  recurringBlock   RecurringBlock? @relation(fields: [recurringBlockId], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  session Session?

  @@index([tenantId, therapistId, scheduledAt])
  // Defesa em profundidade contra dupla-reserva concorrente (Teste Crítico
  // #10): ver prisma/rls/unique-active-appointment.sql — um índice único
  // PARCIAL (só sobre estados não-terminais), aplicado via SQL bruto porque
  // o Prisma Schema DSL não suporta unique index condicional. Um @@unique
  // simples aqui bloquearia incorretamente reagendar um horário já
  // cancelado — por isso não está declarado nesta sintaxe.
  //
  // Já (recurringBlockId, scheduledAt) abaixo PODE usar @@unique nativo: é
  // uma garantia diferente (idempotência de materialização, PD-001 Fase 2,
  // C3), sem a mesma ressalva de estado — decisão arquitetural registrada:
  // não exclui `Cancelada` deliberadamente (ver relatório da C3), então não
  // precisa de índice condicional/SQL bruto. `recurringBlockId` nulo nunca
  // colide consigo mesmo (semântica padrão de UNIQUE com NULL no Postgres),
  // então Appointments avulsos nunca são afetados por esta constraint.
  @@unique([recurringBlockId, scheduledAt])
  @@map("appointment")
}

// Alinhado 1:1 com SessionState em domain/session/session.entity.ts.
// Substituiu SessionStatus (scheduled/completed/no_show — nada a ver com o
// Domain real: Realizada/Faturada/Recebida) no Módulo 07. Ver ADR-0028.
enum SessionState {
  Realizada
  Faturada
  Recebida
}

model Session {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  appointmentId String        @unique @map("appointment_id")
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  patientId     String        @map("patient_id")
  patient       Patient       @relation(fields: [patientId], references: [id])
  therapistId   String        @map("therapist_id")
  therapist     Therapist     @relation(fields: [therapistId], references: [id])
  state         SessionState  @default(Realizada)
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  billingSessions BillingSession[]

  @@index([tenantId, patientId])
  @@map("session")
}

// ─────────────────────────────────────────────
// Financeiro — cobrança agregada via billing_session (N:N)
// ─────────────────────────────────────────────
enum BillingStatus {
  criada
  enviada
  visualizada
  pendente
  atrasada
  negociada
  escalada
  quitada
  cancelada
}

model Billing {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  patientId String        @map("patient_id")
  patient   Patient       @relation(fields: [patientId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  status    BillingStatus @default(criada)
  dueDate   DateTime      @map("due_date")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  billingSessions BillingSession[]
  payment         Payment?

  @@index([tenantId, patientId, status])
  @@map("billing")
}

// Tabela de junção — permite que uma billing agregue N sessions (semanal/mensal)
// ou represente exatamente 1 session (cobrança por sessão avulsa)
model BillingSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  billingId String   @map("billing_id")
  billing   Billing  @relation(fields: [billingId], references: [id])
  sessionId String   @unique @map("session_id") // UNIQUE: uma session nunca em 2 billings abertas ao mesmo tempo
  session   Session  @relation(fields: [sessionId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("billing_session")
}

enum PaymentStatus {
  recebido
  em_conferencia
  confirmado
  divergente
  estornado
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  billingId     String        @unique @map("billing_id")
  billing       Billing       @relation(fields: [billingId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        String
  status        PaymentStatus @default(recebido)
  idempotencyKey String       @unique @map("idempotency_key")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("payment")
}

// ─────────────────────────────────────────────
// Auditoria — ver docs/03-Database/08-Auditoria.md
// ─────────────────────────────────────────────
enum ActorType {
  user
  ai_agent
  system
}

enum AuditResult {
  success
  failure
}

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String      @map("tenant_id")
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  userId     String?     @map("user_id")
  actorType  ActorType   @map("actor_type")
  action     String
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  payload    Json?
  result     AuditResult
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")
  // Sem updatedAt/deletedAt — auditoria é imutável por definição (ver 08-Auditoria.md)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// Módulo 11 (Comunicação) — idempotência real de envio, mesma filosofia de
// defesa em profundidade já aplicada a Payment (Módulo 09, idempotencyKey
// @unique) e ao índice único parcial de Appointment (Módulo 07). Sem isso,
// um retry de fila (BullMQ) poderia reenviar a mesma mensagem ao paciente.
model MessageLog {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  toPhoneNumber  String   @map("to_phone_number")
  body           String
  idempotencyKey String   @unique @map("idempotency_key")
  providerMessageId String? @map("provider_message_id")
  status         String   @default("sent") // sent | failed
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("message_log")
}

// Módulo 17 — Assinatura da Luxora + Asaas (ADR-0037).
// Plano/ciclo/status DA CLÍNICA COM A LUXORA — nunca confundir com Billing
// (Módulo 09), que é o paciente pagando a clínica. Dois domínios financeiros
// completamente separados, mesmo os dois usando Asaas por baixo.
enum PlanTier {
  professional
  business
  enterprise
  // PD-003 (Modelo Comercial), CEO-DEC-002.1 — novo catálogo oficial.
  // Priority 5: apenas estrutura, sem preço nem benefício configurado
  // ainda (CEO-DEC-002.3). Os três valores acima permanecem ativos,
  // exigido por CEO-DEC-002.6 para clientes já contratados.
  individual
  completo
}

enum BillingCycle {
  monthly
  yearly
}

// Fonte: 05-IA/00 nunca define isso — estados definidos aqui pela primeira
// vez, espelhando o ciclo de vida real de uma assinatura recorrente
// (trial opcional → ativa → pode entrar em atraso → pode ser cancelada).
enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

model ClinicSubscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique @map("tenant_id")
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  plan               PlanTier
  billingCycle       BillingCycle       @map("billing_cycle")
  status             SubscriptionStatus @default(trialing)
  // Marco de início do estado PastDue — base do período de tolerância de 7
  // dias (PD-004, CEO-DEC-003.1/003.2). Nulo fora de PastDue.
  pastDueSince       DateTime?          @map("past_due_since")
  // Downgrade agendado (CEO-DEC-002.5, CEO-DEC-003.6) — plano que entrará
  // em vigor no próximo ciclo de cobrança. Nulo quando não há downgrade
  // pendente.
  pendingPlan        PlanTier?          @map("pending_plan")
  // IDs do lado Asaas — nunca o contrário (Asaas nunca conhece nosso id
  // interno como chave primária dele; nós guardamos os dois lados do link).
  asaasCustomerId    String?            @map("asaas_customer_id")
  asaasSubscriptionId String?           @unique @map("asaas_subscription_id")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("clinic_subscription")
}

// Idempotência de webhook (ADR: "nunca use a API Key como token do
// webhook" + "implemente idempotência com base no id do evento", ambos já
// na documentação oficial da Asaas) — mesmo padrão de MessageLog acima.
model AsaasWebhookEvent {
  id          String   @id @default(uuid())
  asaasEventId String  @unique @map("asaas_event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("asaas_webhook_event")
}
