# Luxora — variáveis de ambiente (exemplo)
# Nunca commitar .env real — apenas este .env.example

# Backend
# NUNCA usar o usuário "postgres" (superusuário) aqui — o Postgres ignora
# Row-Level Security incondicionalmente para superusuários, o que
# desativaria silenciosamente todo o isolamento multi-tenant (ver
# infra/docker/postgres-init/01-app-role.sql). "luxora_app" é criado
# automaticamente pelo docker-compose deste repositório.
DATABASE_URL="postgresql://luxora_app:luxora_app_dev_pw@localhost:5432/luxora_dev"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="troque-este-valor-em-todo-ambiente"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# Provedor de IA (ver docs/05-IA/00-Provedor-e-Interface.md)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"
AI_COST_CEILING_PER_CONVERSATION="0.25"

# WhatsApp Business API — NÃO é mais configurado globalmente aqui.
# Diretriz: cada clínica conecta seu próprio canal via POST /whatsapp/connect,
# credenciais ficam em whatsapp_integration (por Tenant), nunca em variável
# de ambiente global. Ver docs/CONFIGURACAO_AMBIENTE.md.

# Object Storage (ver ADR-0013)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="luxora-uploads"

# Ambiente
NODE_ENV="development"

# Asaas — gateway oficial de pagamentos do MVP (ver ADR-0003, ADR-0037)
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
# Token PRÓPRIO do webhook — nunca a ASAAS_API_KEY (a doc oficial da Asaas
# é explícita sobre isso). Gerado por você, configurado no painel da Asaas
# em Integrações > Webhooks, e aqui, nos dois lugares precisa ser igual.
ASAAS_WEBHOOK_TOKEN=""

# Módulo 14 — chave usada pelo n8n para chamar endpoints de automação
AUTOMATION_API_KEY=""

# Módulo 15 — Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
