# Luxora — variáveis de ambiente (exemplo)
# Nunca commitar .env real — apenas este .env.example

# Backend
# NUNCA usar o usuário "postgres" (superusuário) aqui — o Postgres ignora
# Row-Level Security incondicionalmente para superusuários, o que
# desativaria silenciosamente todo o isolamento multi-tenant (ver
# infra/docker/postgres-init/01-app-role.sql). "luxora_app" é criado
# automaticamente pelo docker-compose deste repositório.
DATABASE_URL="postgresql://luxora_app:luxora_app_dev_pw@localhost:5432/luxora_dev"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="troque-este-valor-em-todo-ambiente"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# AD-006 — rate limit de POST /auth/login (proteção contra força bruta).
# Chave padrão do @nestjs/throttler: IP do cliente (req.ip) — depende de
# app.set('trust proxy', 1) em main.ts para funcionar corretamente atrás
# de um reverse proxy (Railway, produção).
AUTH_THROTTLE_LIMIT="5"
AUTH_THROTTLE_TTL_MS="60000"

# Provedor de IA (ver docs/05-IA/00-Provedor-e-Interface.md)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"
AI_COST_CEILING_PER_CONVERSATION="0.25"

# WhatsApp Business API — NÃO é mais configurado globalmente aqui.
# Diretriz: cada clínica conecta seu próprio canal via POST /whatsapp/connect,
# credenciais ficam em whatsapp_integration (por Tenant), nunca em variável
# de ambiente global. Ver docs/CONFIGURACAO_AMBIENTE.md.
# AD-005: chave usada para cifrar/decifrar accessToken em repouso — mesma
# UX de JWT_SECRET (qualquer string aleatória longa, nunca uma chave exata
# em base64). Trocar este valor torna todo accessToken já cifrado
# irrecuperável — tratar como segredo crítico de backup.
WHATSAPP_TOKEN_ENCRYPTION_KEY="troque-este-valor-em-todo-ambiente"

# Object Storage (ver ADR-0013)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="luxora-uploads"

# Ambiente
NODE_ENV="development"

# Asaas — gateway oficial de pagamentos do MVP (ver ADR-0003, ADR-0037)
# A Luxora não tem conta sandbox da Asaas — produção é o único ambiente
# real desde o início. ASAAS_API_KEY é a chave de produção, obtida no
# painel da própria Asaas (conta da Luxora), colada SÓ no seu .env local,
# nunca em código-fonte, nunca commitada.
ASAAS_API_KEY=""
ASAAS_ENV="production"
ASAAS_BASE_URL="https://api.asaas.com/v3"
# Token PRÓPRIO do webhook — nunca a ASAAS_API_KEY (a doc oficial da Asaas
# é explícita sobre isso). Gerado por você, configurado no painel da Asaas
# em Integrações > Webhooks, e aqui, nos dois lugares precisa ser igual.
ASAAS_WEBHOOK_TOKEN=""
# Opcional — só para test/manual/asaas-production-smoke.test.ts (nunca roda
# sozinho, ver test/manual/README.md). CPF ou CNPJ real (seu ou da clínica),
# nunca um valor inventado — a Asaas valida e cria um cliente de verdade
# associado a esse documento.
ASAAS_TEST_CPF_CNPJ=""

# Módulo 14 — chave usada pelo n8n para chamar endpoints de automação
AUTOMATION_API_KEY=""

# AD-016 — token exigido no header X-Metrics-Token para acessar GET /metrics
# (Prometheus). Nunca deixar a rota pública — expõe contagens operacionais e
# de negócio (ver docs/02-Arquitetura/11-Monitoramento.md).
METRICS_ACCESS_TOKEN=""

# Módulo 15 — Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
# Origens permitidas por CORS no backend (separadas por vírgula) — sem isso
# o navegador bloqueia toda chamada do frontend para a API (preflight
# OPTIONS falha antes do POST real). 3001/3002 cobre o Next escolhendo
# porta automaticamente quando 3000 (do backend) já está ocupada.
FRONTEND_URL="http://localhost:3001,http://localhost:3002"
